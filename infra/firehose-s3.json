{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Laboratorio: Kinesis Data Streams existente -> Amazon Data Firehose -> S3 (JSON Lines)",
  "Parameters": {
    "KinesisStreamName": {
      "Type": "String",
      "Default": "lab-lecturas",
      "Description": "Nombre del stream creado en la primera parte"
    },
    "BucketName": {
      "Type": "String",
      "Description": "Nombre globalmente unico, en minusculas, para el bucket de este laboratorio",
      "AllowedPattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
    }
  },
  "Resources": {
    "LecturasBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": { "Ref": "BucketName" },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            { "ServerSideEncryptionByDefault": { "SSEAlgorithm": "AES256" } }
          ]
        }
      }
    },
    "FirehoseRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": { "Service": "firehose.amazonaws.com" },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "LeerKinesisYEscribirS3",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "kinesis:DescribeStream",
                    "kinesis:GetShardIterator",
                    "kinesis:GetRecords",
                    "kinesis:ListShards"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:kinesis:${AWS::Region}:${AWS::AccountId}:stream/${KinesisStreamName}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": ["s3:GetBucketLocation", "s3:ListBucket", "s3:ListBucketMultipartUploads"],
                  "Resource": { "Fn::GetAtt": ["LecturasBucket", "Arn"] }
                },
                {
                  "Effect": "Allow",
                  "Action": ["s3:AbortMultipartUpload", "s3:GetObject", "s3:PutObject"],
                  "Resource": { "Fn::Sub": "${LecturasBucket.Arn}/*" }
                }
              ]
            }
          }
        ]
      }
    },
    "LecturasFirehose": {
      "Type": "AWS::KinesisFirehose::DeliveryStream",
      "Properties": {
        "DeliveryStreamName": "lab-lecturas-s3",
        "DeliveryStreamType": "KinesisStreamAsSource",
        "KinesisStreamSourceConfiguration": {
          "KinesisStreamARN": {
            "Fn::Sub": "arn:${AWS::Partition}:kinesis:${AWS::Region}:${AWS::AccountId}:stream/${KinesisStreamName}"
          },
          "RoleARN": { "Fn::GetAtt": ["FirehoseRole", "Arn"] }
        },
        "ExtendedS3DestinationConfiguration": {
          "BucketARN": { "Fn::GetAtt": ["LecturasBucket", "Arn"] },
          "RoleARN": { "Fn::GetAtt": ["FirehoseRole", "Arn"] },
          "Prefix": "lecturas/year=!{timestamp:yyyy}/month=!{timestamp:MM}/day=!{timestamp:dd}/hour=!{timestamp:HH}/",
          "ErrorOutputPrefix": "errores/!{firehose:error-output-type}/year=!{timestamp:yyyy}/month=!{timestamp:MM}/day=!{timestamp:dd}/hour=!{timestamp:HH}/",
          "BufferingHints": { "SizeInMBs": 1, "IntervalInSeconds": 60 },
          "CompressionFormat": "UNCOMPRESSED",
          "ProcessingConfiguration": {
            "Enabled": true,
            "Processors": [{ "Type": "AppendDelimiterToRecord" }]
          }
        }
      }
    }
  },
  "Outputs": {
    "Bucket": { "Value": { "Ref": "LecturasBucket" } },
    "Firehose": { "Value": { "Ref": "LecturasFirehose" } },
    "PrefijoDatos": { "Value": { "Fn::Sub": "s3://${LecturasBucket}/lecturas/" } }
  }
}
