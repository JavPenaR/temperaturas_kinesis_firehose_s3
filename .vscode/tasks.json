{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar backend con Maven Wrapper",
      "type": "shell",
      "command": "./mvnw",
      "windows": {
        "command": ".\\mvnw.cmd"
      },
      "args": ["-q", "-DskipTests", "package"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": ["$javac"]
    }
  ]
}
